# ── 시크릿 (절대 커밋 금지) ──────────────────────────
.env
.env.*
!.env.example
config/secrets.yaml
firmware_xiao_vision/wifi_secrets.h
firmware_lidar_relay/**/wifi_secrets.h
firmware_lidar_relay/wifi_secrets.h

# ── 개체별 로컬 설정 ────────────────────────────────
# 개체 프로파일 템플릿은 커밋하고, 실측 캘리브레이션 값은 로컬 유지
config/devices/*.local.yaml

# ── Python ──────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# ── 임베디드 빌드 산출물 ────────────────────────────
.pio/
build/
*.bin
*.elf
*.map
*.hex

# ── AI 모델 가중치 (용량 큼 — 별도 배포) ────────────
*.pt
*.onnx
*.engine
models/*
!models/README.md

# ── 런타임 산출물 ───────────────────────────────────
logs/
*.log
*.jsonl
# 정본 픽스처는 산출물이 아니라 소스다 (CONTRIBUTING 5.2)
!tests/fixtures/*.jsonl
snapshots/
blackbox/
maps/*
!maps/README.md

# 검증용 실제 사진 — COCO 주석은 CC-BY-4.0 이지만 사진은 Flickr 개별 라이선스다.
# `python tools/fetch_models.py --samples` 로 받는다.
datasets/*
!datasets/README.md
recordings/
*.bag
*.db3

# ── ROS2 ───────────────────────────────────────────
install/
log/
devel/

# ── 벤더 파일 — 재배포 불가, 절대 커밋 금지 (ADR-20) ──
# 구동 빌드는 Hiwonder 벤더 소스를 스케치 폴더에 두어야 컴파일된다(펌웨어 README).
# 문서대로 복사한 뒤 `git add .` 한 번이면 공개 저장소에 올라가므로 여기서 막는다.
firmware_mechdog_motion/**/HW_MechDog.*
firmware_mechdog_motion/**/Hiwonder.*
firmware_mechdog_motion/**/Servo.*
firmware_mechdog_motion/**/WMMatrixLed.*
firmware_mechdog_motion/**/pwm_servo.*
firmware_mechdog_motion/**/action.h

# ── OS / 에디터 ─────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~

# ── 음성 캐시 (생성물, 대용량 바이너리 — gen_voice_cache.py로 재생성 가능) ──
experiments/wonderecho-audio/voice_cache/
experiments/wonderecho-audio/emergency_log.txt
experiments/wonderecho-audio/phrases_custom.json
# 가상 MES 데모 DB — factory_mes.py --seed / --serve 시 자동 재생성
experiments/wonderecho-audio/mes_demo.db
# 음성 모듈 설정 오버레이 — voice_store.py --seed 로 재생성 (없으면 코드 기본값)
experiments/wonderecho-audio/voice_data.db
# Local DB imports, previews, WAL files and automatic backups are runtime data.
experiments/wonderecho-audio/db_exports/
experiments/wonderecho-audio/*.db
experiments/wonderecho-audio/*.db-*
experiments/wonderecho-audio/*.db.*.bak

# 시뮬은 로컬 전용으로 둔다 (WBS 미등재 — 팀 합의 후 다시 올린다).
# 되살리려면 `git show bb4d704` — 15개 파일 1,801줄이 거기 있다 (#153 로 들어와
# #160 에서 되돌림). 브랜치가 아니라 커밋을 적는다: 브랜치는 사라질 수 있다.
sim/

# Local routing configuration migrated from the voice DB.
experiments/wonderecho-audio/*.rules.json
experiments/wonderecho-audio/*.json.migrated.bak
